PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/four_score

# Email — Nodemailer/SMTP (default)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@4scorefit.com
SMTP_PASS=your_mailbox_app_password_without_spaces
MAIL_FROM=noreply@4scorefit.com
MAIL_FROM_NAME=Four Score
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Optional: SendGrid instead of SMTP
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_key
# SENDGRID_TLS_REJECT_UNAUTHORIZED=false

SIGNUP_OTP_EMAIL_SUBJECT=Verify your Four Score account
USER_RESET_EMAIL_SUBJECT=Reset your password
USER_RESET_PASSWORD_URL=https://for-score-frontend.vercel.app/reset-password
ADMIN_RESET_PASSWORD_URL=https://for-score-frontend.vercel.app/reset-password
