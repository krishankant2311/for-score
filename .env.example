# Push Notifications (OneSignal)
# Dashboard → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
# App API Key — full secret starting with os_v2_app_ (NOT the Key ID column)
ONESIGNAL_REST_API_KEY=os_v2_app_your_key_here
# Legacy v1 API (required for os_v2_app keys in this project):
# ONESIGNAL_API_HOST=onesignal.com
# ONESIGNAL_API_PATH=/api/v1/notifications
ONESIGNAL_TLS_REJECT_UNAUTHORIZED=false
