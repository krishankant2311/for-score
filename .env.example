# Push Notifications (OneSignal)
# Dashboard → Settings → Keys & IDs
ONESIGNAL_APP_ID=your-onesignal-app-id
# App API Key — full secret starting with os_v2_app_ (NOT the Key ID column)
ONESIGNAL_REST_API_KEY=os_v2_app_your_key_here
ONESIGNAL_TLS_REJECT_UNAUTHORIZED=false

# Login + From: same noreply mailbox (Gmail/Google Workspace App Password)
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Four Score
SMTP_TLS_REJECT_UNAUTHORIZED=false
SIGNUP_OTP_EMAIL_SUBJECT=Verify your Four Score account
# QA only — return OTP in /signup-return-otp JSON (default: email only)
# SIGNUP_RETURN_OTP_IN_RESPONSE=true
